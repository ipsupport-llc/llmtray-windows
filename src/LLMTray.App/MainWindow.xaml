<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LLMTray.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LLMTray">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24,16,24,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Image Source="Assets/Square44x44Logo.png" Width="36" Height="36" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LLMTray" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Local AI Runtime for Windows" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="VersionText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ComboBox x:Name="ChannelBox" Grid.Column="2" VerticalAlignment="Center" SelectionChanged="ChannelBox_SelectionChanged">
                <x:String>Stable</x:String>
                <x:String>Beta</x:String>
            </ComboBox>
            <Button x:Name="CheckUpdatesButton" Grid.Column="3" Content="Check for updates" Click="CheckUpdates_Click" />
        </Grid>

        <InfoBar x:Name="UpdateBar" Grid.Row="1" IsClosable="True" IsOpen="False" Closed="UpdateBar_Closed">
            <InfoBar.ActionButton>
                <Button x:Name="InstallUpdateButton" Content="Install and restart" Click="InstallUpdate_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Status and API -->
        <Border Grid.Row="2" Padding="16" CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ProgressRing x:Name="Loading" Width="16" Height="16" IsActive="False" />
                </StackPanel>
                <TextBlock x:Name="DetailText" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="API" VerticalAlignment="Center" />
                    <TextBox x:Name="ApiUrl" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" />
                    <Button Grid.Column="2" Content="Copy" Click="CopyApi_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Models -->
        <Grid Grid.Row="3" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Models" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="FolderText" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Get models…" Style="{StaticResource AccentButtonStyle}" Click="GetModels_Click" />
                <Button Grid.Column="2" Content="Refresh" Click="Refresh_Click" />
                <Button Grid.Column="3" Content="Open folder" Click="OpenFolder_Click" />
                <Button Grid.Column="4" Content="Change folder…" Click="ChangeFolder_Click" />
            </Grid>

            <ListView x:Name="ModelsList" Grid.Row="1" SelectionMode="Single" DoubleTapped="ModelsList_DoubleTapped"
                      SelectionChanged="ModelsList_SelectionChanged"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            </ListView>
            <TextBlock x:Name="EmptyText" Grid.Row="1" Margin="16" TextWrapping="Wrap" Visibility="Collapsed"
                       VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Grid x:Name="DownloadPanel" Grid.Row="2" ColumnSpacing="8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock x:Name="DownloadText" TextWrapping="Wrap" />
                    <ProgressBar x:Name="DownloadProgress" Maximum="1000" />
                </StackPanel>
                <Button x:Name="DownloadCancel" Grid.Column="1" Content="Cancel" Click="DownloadCancel_Click" />
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                <Button x:Name="LoadButton" Content="Load" Click="Load_Click" IsEnabled="False" />
                <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" IsEnabled="False" />
            </StackPanel>
        </Grid>

        <!-- Server log -->
        <Expander x:Name="LogExpander" Grid.Row="4" Header="Server log" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch" Expanding="LogExpander_Expanding" Collapsed="LogExpander_Collapsed">
            <TextBox x:Name="LogText" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Height="200"
                     TextWrapping="NoWrap" AcceptsReturn="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Expander>
    </Grid>
</Window>
