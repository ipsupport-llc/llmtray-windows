<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LLMTray.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="LLMTray">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <TextBlock Text="LLMTray" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
        <TextBlock x:Name="ApiLine" Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Center" />
    </StackPanel>
</Window>
